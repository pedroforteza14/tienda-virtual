# ---------------------------------------------------------------------------
# OWNER STORE — environment template.
# Copy to `.env.local` and fill in. NEVER commit `.env.local` or `.env`.
# Every value here is a placeholder: no real secret belongs in this file.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Public origin of the deployment. Used for canonical URLs, sitemap, OG tags
# and for the strict same-origin / CORS allow-list.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"
# Set to "false" on a staging host so robots.txt disallows everything and the
# staging site can never outrank production. Indexing is also disabled
# automatically unless NEXT_PUBLIC_SITE_URL is a public https origin.
NEXT_PUBLIC_ALLOW_INDEXING="true"

# --- Session signing --------------------------------------------------------
# 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this invalidates every session and guest cart. Required in production.
SESSION_SECRET=""

# --- Contact ----------------------------------------------------------------
# Digits only, full international format, no "+" and no spaces.
NEXT_PUBLIC_WHATSAPP_NUMBER="5491100000000"
NEXT_PUBLIC_INSTAGRAM_HANDLE="ownerstoreok"
NEXT_PUBLIC_CONTACT_EMAIL="hola@ownerstore.example"

# --- Payments (server-only — never expose these to the browser) -------------
# Adapter selection: "mock" | "mercadopago" | "stripe"
PAYMENT_PROVIDER="mock"

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Shared store -----------------------------------------------------------
# Where sessions, users, orders, stock reservations, the webhook log and the
# rate-limit counters are kept.
#
#   "memory"  — one process. Correct for local development and a single VPS.
#   "upstash" — shared Redis over its REST API. REQUIRED on any serverless or
#               multi-replica host (Vercel included): instances do not share
#               memory, so with "memory" an order created by one is invisible
#               to the next and logins drop at random.
#
# Create a database at console.upstash.com and copy the REST url and token.
# The token is server-only: never prefix it NEXT_PUBLIC_.
STORE_DRIVER="memory"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Key namespace, so one Redis database can serve staging and production.
STORE_PREFIX="owner:"

# --- Observability ----------------------------------------------------------
# "debug" | "info" | "warn" | "error"
LOG_LEVEL="info"
